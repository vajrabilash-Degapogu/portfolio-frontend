# Copy to .env for local development. Never commit real credentials.
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_EMAIL=you@example.com
# Use a long random secret (32+ bytes).
JWT_SECRET=replace_with_a_long_random_secret
# Gmail requires a Google App Password, not your normal Google password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=replace_with_google_app_password
MAIL_FROM="Portfolio Admin <you@gmail.com>"
# Use persistent disks for production.
UPLOAD_DIR=./uploads
DATABASE_PATH=./data/portfolio.sqlite
